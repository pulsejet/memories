<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" disables cloud backup but not device-to-device transfer. -->
<data-extraction-rules>
    <device-transfer>
        <!-- The token's Keystore key can't leave the device; session cookies are live credentials. -->
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="sharedpref" path="session_cookies.xml" />
    </device-transfer>
</data-extraction-rules>
