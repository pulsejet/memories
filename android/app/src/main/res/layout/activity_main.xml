<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <!-- Native images shown through the webview hole. -->
        <!-- Invisible (not gone) to allow decoding. -->
        <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
            android:id="@+id/nativeImageA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
        />

        <!-- Ping-pong counterpart for the view above. -->
        <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
            android:id="@+id/nativeImageB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
        />

        <!-- Native video shown through the webview hole. -->
        <!-- Invisible (not gone) to keep the surface alive. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/nativeVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:surface_type="surface_view"
            app:use_controller="false"
        />

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:soundEffectsEnabled="true"
        />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>